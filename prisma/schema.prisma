generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// Embedding has 768 numbers, the size nomic-embed-text returns. Read and written with raw SQL only.
model Chunk {
  id        BigInt                     @id @default(autoincrement())
  content   String
  source    String
  embedding Unsupported("vector(768)")

  @@map("chunks")
}
