# Copy to .env and adjust. docker-compose.yml and the app both read .env.

# App
NODE_ENV=development
PORT=5000

# PostgreSQL (docker compose)
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=starter_db
POSTGRES_PORT=5433

# Prisma connection string; keep in sync with the values above
DATABASE_URL=postgresql://admin:admin@localhost:5433/starter_db

# Web app origin, allowed by CORS
WEB_ORIGIN=http://localhost:5001
